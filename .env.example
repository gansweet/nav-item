# 复制为 .env 后按需修改（Node / Docker / Debian 部署使用；Cloudflare 请看 README 与 wrangler.toml）
PORT=3000
ADMIN_USERNAME=amos
ADMIN_PASSWORD=sweet
# JWT 签名密钥：留空则首次启动自动生成并保存在数据库里。多实例共享同一数据库时无需配置。
# JWT_SECRET=
# SQLite 数据库文件路径（默认 ./database/nav.db）
# DB_PATH=./database/nav.db
# 允许“从 URL 下载导入 / 远程数据库连接”访问内网地址（默认禁止，防止 SSRF）
# ALLOW_PRIVATE_NETWORK=false
